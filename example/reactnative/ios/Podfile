# Explicitly enable the New Architecture
# SEe https://reactnative.dev/architecture/landing-page#should-i-use-the-new-architecture-today
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'reactNativeExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Use WechatOpenSDK-XCFramework instead of WechatOpenSDK
  # See https://developers.weixin.qq.com/community/develop/doc/000c62b9b0ccf8c1d65fa90b751001?blockType=1
  #
  # Pinned to an exact version rather than '~> 2.0.4': later 2.0.x releases
  # (e.g. 2.0.5) ship a simulator xcframework slice that excludes an
  # architecture Xcode still tries to build for on this toolchain, which
  # breaks the build with a "file not found" error on WXApi.h. 2.0.4 is the
  # last version confirmed to build cleanly for both simulator archs.
  pod 'WechatOpenSDK-XCFramework', '2.0.4'

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
